# Multi-architecture Dockerfile for TenSEAL ARM64 builds
# Supports: Jetson Orin NX, Raspberry Pi 4/5, and other ARM64 devices
# Base: manylinux_2_28 compatible (glibc 2.28+, Ubuntu 20.04+, Debian 10+)

ARG PYTHON_VERSION=3.11
ARG BASE_IMAGE=arm64v8/python:${PYTHON_VERSION}-slim-bookworm

FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive

# Install build dependencies
RUN apt-get update && apt-get install -y \
    wget \
    curl \
    git \
    build-essential \
    automake \
    libtool \
    libtool-bin \
    clang \
    ninja-build \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Install CMake (architecture-aware)
ARG CMAKE_VERSION=3.28.0
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ] || [ "$ARCH" = "arm64" ]; then \
        cmake_file="cmake-${CMAKE_VERSION}-linux-aarch64.sh"; \
    else \
        cmake_file="cmake-${CMAKE_VERSION}-linux-x86_64.sh"; \
    fi && \
    wget https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/${cmake_file} && \
    sh ${cmake_file} --skip-license --prefix=/usr/local/ --exclude-subdir && \
    rm ${cmake_file}

# Set compiler environment
ENV CC=clang \
    CXX=clang++

# Copy TenSEAL source
COPY ./ /TenSEAL
WORKDIR /TenSEAL

# Install Python dependencies
RUN pip install --upgrade pip setuptools wheel && \
    pip install -r requirements_dev.txt

# Build TenSEAL
RUN pip install .

ENTRYPOINT [ "/bin/bash" ]
